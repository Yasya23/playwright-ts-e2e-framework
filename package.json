  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/Yasya23/Playwright/issues"
  },
  "homepage": "https://github.com/Yasya23/Playwright#readme",
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.2.0",
    "open-cli": "^8.0.0",
    "rimraf": "^5.0.0",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "dotenv": "^17.4.2"
  }
}
