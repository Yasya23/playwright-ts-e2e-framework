{
  "name": "playwright-framework",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "test:ui": "playwright test --ui",
    "test:run": "playwright test",
    "test": "npm run clean:reports && npm run test:run",
    "test:chrome": "npm run clean:reports && playwright test --project=Chromium",
    "test:firefox": "npm run clean:reports && playwright test --project=Firefox",
    "test:safari": "npm run clean:reports && playwright test --project=Webkit",
    "test:headed": "npm run clean:reports && playwright test --headed",
    "report:open": "open-cli playwright-report/html/index.html",
    "clean:reports": "rimraf playwright-report test-results",
    "type-check": "tsc --noEmit"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Yasya23/Playwright.git"
  },
  "keywords": [],
